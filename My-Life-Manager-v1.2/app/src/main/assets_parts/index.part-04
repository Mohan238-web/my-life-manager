        },
        {
          id: "mileage",
          name: "Mileage Calculator",
          icon: "⌁",
          data: "",
        },
      ];
      const frame = document.querySelector("#frame"),
        items = document.querySelector(".items"),
        matrix = document.querySelector("#matrix"),
        loading = document.querySelector("#loading");
      let active = -1;
      const setOpen = (v) => {
        document.body.classList.toggle("open", v);
        matrix.setAttribute("aria-expanded", String(v));
      };
      async function unpack(data) {
        const bytes = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));
        const stream = new Blob([bytes])
          .stream()
          .pipeThrough(new DecompressionStream("gzip"));
        return await new Response(stream).text();
      }
      async function openPage(index) {
        if (index === active) {
          setOpen(false);
          return;
        }
        active = index;
        const page = pages[index];
        loading.textContent = "Opening " + page.name + "…";
        loading.classList.remove("hide");
        frame.title = page.name;
        frame.srcdoc = await unpack(page.data);
        [...items.children].forEach((b, i) =>
          b.classList.toggle("active", i === index),
        );
        setOpen(false);
      }
      pages.forEach((p, i) => {
        const b = document.createElement("button");
        b.className = "item";
        b.type = "button";
        b.innerHTML =
          '<span class="num">' + p.icon + "</span><span>" + p.name + "</span>";
        b.onclick = () => openPage(i);
        items.append(b);
      });
      frame.addEventListener("load", () => loading.classList.add("hide"));
      matrix.onclick = () => setOpen(!document.body.classList.contains("open"));
      document.querySelector(".close").onclick = () => setOpen(false);
      document.querySelector("#shade").onclick = () => setOpen(false);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
      openPage(0);
    </script>
  </body>
</html>

<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f6f7f5"><meta name="application-name" content="My Life Manager"><meta name="mlm-build" content="9.13.6-icon-only-top-nav"><title>My Life Manager — Icon Only Top Navigation v9.13.6</title><style id="mlm-v90-core">:root{--bg:#f6f7f5;--surface:#fff;--surface2:#eef2ef;--text:#18211e;--muted:#5f6c67;--line:#d8dfda;--accent:#2f766d;--accentSoft:#dcece8;--danger:#b42318;--shadow:0 10px 32px rgba(18,35,29,.08);--fast:120ms;--normal:180ms;--slow:240ms;--ease:cubic-bezier(.2,.8,.2,1);color-scheme:light}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}button,select,input,textarea{font:inherit}button{touch-action:manipulation;-webkit-tap-highlight-color:transparent}button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 72%,white);outline-offset:2px}.skip{position:fixed;z-index:1000;left:12px;top:8px;transform:translateY(-160%);padding:10px 14px;border-radius:10px;background:var(--accent);color:#fff;font-weight:800;text-decoration:none}.skip:focus{transform:none}.shell{display:grid;grid-template-rows:54px 72px minmax(0,1fr);width:100%;height:100dvh;background:var(--bg)}.appbar{display:grid;grid-template-columns:minmax(0,1fr) 46px;align-items:center;gap:6px;padding:0 8px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface) 97%,transparent);backdrop-filter:blur(16px);z-index:30}.brand{display:flex;align-items:center;gap:9px;min-width:0}.brandmark{display:grid;place-items:center;width:34px;height:34px;flex:0 0 34px;border:1px solid color-mix(in srgb,var(--accent) 36%,var(--line));border-radius:11px;background:linear-gradient(145deg,var(--accentSoft),var(--surface));color:var(--accent);font-size:10px;font-weight:900}.brandcopy{display:grid;min-width:0}.brandcopy strong{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.brandcopy small{margin-top:2px;color:var(--muted);font-size:10px;font-weight:700}.appmeta{display:flex;align-items:center;justify-content:center;gap:0;margin-left:0}.save-state{display:flex;align-items:center;gap:6px;max-width:170px;color:var(--muted);font-size:10px;font-weight:760;white-space:nowrap}.save-dot{width:8px;height:8px;border-radius:50%;background:#18865d;box-shadow:0 0 0 4px color-mix(in srgb,#18865d 12%,transparent)}.save-state[data-state="saving"] .save-dot{background:#c47a16}.save-state[data-state="error"]{color:var(--danger)}.save-state[data-state="error"] .save-dot{background:var(--danger)}.iconbtn,.colorbtn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:44px;min-height:42px;padding:0 10px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,var(--surface),var(--surface2));color:var(--text);font-size:11px;font-weight:820;cursor:pointer;box-shadow:0 2px 0 color-mix(in srgb,var(--line) 72%,transparent);transition:transform var(--fast) var(--ease),border-color var(--normal) var(--ease),background-color var(--normal) var(--ease)}.iconbtn:active,.colorbtn:active{transform:translateY(1px);box-shadow:none}.colorbtn{width:44px;padding:0}.colorbtn input{position:absolute;width:1px;height:1px;opacity:0}.toolrail{display:grid;align-items:center;padding:6px 8px 8px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface) 96%,var(--bg));box-shadow:0 4px 14px rgba(19,37,31,.04);z-index:20}.tools{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;width:min(100%,700px);margin:0 auto}.tool{position:relative;display:grid;grid-template-rows:28px auto;place-items:center;gap:2px;min-width:0;min-height:56px;padding:4px 3px;border:1px solid var(--line);border-radius:13px;background:linear-gradient(180deg,var(--surface),var(--surface2));color:var(--muted);cursor:pointer;box-shadow:0 2px 0 color-mix(in srgb,var(--line) 72%,transparent);transition:transform var(--fast) var(--ease),border-color var(--normal) var(--ease),background-color var(--normal) var(--ease),color var(--normal) var(--ease)}.tool:hover{transform:translateY(-1px);border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}.tool:active{transform:translateY(1px);box-shadow:none}.tool.active{border-color:color-mix(in srgb,var(--accent) 62%,var(--line));background:linear-gradient(180deg,var(--surface),var(--accentSoft));color:var(--accent)}.tool.active::after{content:'✓';position:absolute;top:3px;right:3px;display:grid;place-items:center;width:15px;height:15px;border:2px solid var(--surface);border-radius:50%;background:var(--accent);color:#fff;font-size:7px;font-weight:900}.toolicon{display:grid;place-items:center;width:28px;height:28px;border:1px solid color-mix(in srgb,var(--accent) 34%,var(--line));border-radius:9px;background:color-mix(in srgb,var(--accentSoft) 58%,var(--surface));color:var(--accent)}.tool.active .toolicon{background:var(--accent);border-color:var(--accent);color:#fff}.toolicon svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}.toollabel{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;font-weight:820;line-height:1.05}.workspace{position:relative;min-width:0;min-height:0;overflow:hidden;background:var(--bg)}.frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:var(--bg);visibility:hidden;opacity:0;pointer-events:none}.frame.active{visibility:visible;opacity:1;pointer-events:auto}.loading{position:absolute;z-index:10;inset:0;display:grid;place-items:center;background:var(--bg);color:var(--muted);transition:opacity var(--normal) var(--ease)}.loading.hide{opacity:0;pointer-events:none}.loadingcard{display:grid;justify-items:center;gap:11px;padding:24px;text-align:center}.spinner{width:34px;height:34px;border:3px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite}.loadingcard strong{color:var(--text);font-size:14px}.loadingcard span{font-size:12px}@keyframes spin{to{transform:rotate(360deg)}}.overlay{position:fixed;z-index:500;inset:0;display:grid;place-items:center;padding:18px;background:rgba(15,25,22,.54);backdrop-filter:blur(12px)}.overlay[hidden]{display:none!important}.panel{width:min(100%,780px);max-height:min(92dvh,900px);overflow:auto;border:1px solid var(--line);border-radius:22px;background:var(--surface);box-shadow:0 28px 80px rgba(11,25,20,.28)}.panel.small{width:min(100%,410px)}.panelhead{position:sticky;z-index:2;top:0;display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:64px;padding:12px 16px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface) 95%,transparent);backdrop-filter:blur(18px)}.panelhead h2{margin:0;font-size:19px}.panelhead p{margin:3px 0 0;color:var(--muted);font-size:11px}.panelbody{display:grid;gap:12px;padding:14px}.card{padding:15px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}.card h3{margin:0 0 4px;font-size:15px}.card>p{margin:0 0 10px;color:var(--muted);font-size:12px;line-height:1.5}.row{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:56px;padding:8px 0;border-top:1px solid var(--line)}.row:first-of-type{border-top:0}.copy{min-width:0}.copy b{display:block;font-size:13px}.copy small{display:block;margin-top:3px;color:var(--muted);font-size:11px;line-height:1.4}select,.pinfield{min-height:44px;padding:0 12px;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--text)}.switch{position:relative;display:inline-flex;width:48px;height:28px;flex:0 0 auto}.switch input{position:absolute;opacity:0}.switch span{width:100%;height:100%;border:1px solid var(--line);border-radius:999px;background:var(--surface2)}.switch span::after{content:'';position:absolute;top:4px;left:4px;width:20px;height:20px;border-radius:50%;background:var(--muted);transition:transform var(--normal) var(--ease),background-color var(--normal) var(--ease)}.switch input:checked+span{border-color:var(--accent);background:var(--accentSoft)}.switch input:checked+span::after{transform:translateX(20px);background:var(--accent)}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.action{min-height:44px;padding:0 14px;border:1px solid var(--line);border-radius:11px;background:var(--surface2);color:var(--text);font-weight:800;cursor:pointer}.action.primary{border-color:var(--accent);background:var(--accent);color:#fff}.action.danger{border-color:#e8b5b5;background:#fff0f0;color:var(--danger)}.action:disabled{opacity:.45;cursor:not-allowed}.status{margin-top:10px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:var(--surface2);color:var(--muted);font-size:12px;line-height:1.45}.healthlist{display:grid;gap:7px;margin-top:10px}.health{display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;padding:9px 10px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);font-size:12px}.health b{display:block}.health small{display:block;margin-top:2px;color:var(--muted)}.ok{color:#16805c;font-weight:900}.bad{color:var(--danger);font-weight:900}.pinbody{padding:20px}.pinbody h2{margin:0 0 5px}.pinbody p{margin:0 0 14px;color:var(--muted);font-size:12px;line-height:1.5}.pinbody label{display:block;margin:11px 0 5px;font-size:12px;font-weight:800}.pinfield{display:block;width:100%;font-size:18px;letter-spacing:.18em;text-align:center}.pinerror{min-height:20px;margin-top:9px;color:var(--danger);font-size:12px;text-align:center}.lockmark{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 12px;border-radius:18px;background:var(--accentSoft);color:var(--accent);font-size:27px}.center{text-align:center}.banner{position:fixed;z-index:700;left:50%;bottom:18px;translate:-50% 0;width:min(calc(100% - 24px),580px);padding:12px 14px;border:1px solid #e0b4b0;border-radius:14px;background:#fff1f0;color:#7d1913;box-shadow:var(--shadow);font-size:13px}.banner[hidden]{display:none}.accent-controls{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.accent-controls input{width:44px;height:44px;padding:3px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}html[data-text="large"]{font-size:18px}html[data-contrast="high"]{--line:color-mix(in srgb,var(--text) 48%,transparent);--muted:color-mix(in srgb,var(--
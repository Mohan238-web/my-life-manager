text) 76%,transparent)}html[data-reduce="true"] *,html[data-reduce="true"] *::before,html[data-reduce="true"] *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.shell.editor-focus{grid-template-rows:1fr}.shell.editor-focus .appbar,.shell.editor-focus .toolrail{display:none}.shell.editor-focus .workspace{grid-row:1}.confirm-message{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.progressbar{height:8px;margin-top:10px;border-radius:99px;background:var(--surface2);overflow:hidden}.progressbar>span{display:block;width:0;height:100%;background:var(--accent);transition:width var(--normal) var(--ease)}@media(max-width:720px){.shell{grid-template-rows:52px 68px minmax(0,1fr)}.appbar{padding:0 7px}.brandmark{width:32px;height:32px;flex-basis:32px}.toolrail{padding:5px 5px 7px}.tools{gap:4px}.tool{min-height:54px;border-radius:12px}.toollabel{font-size:9px}.settings-word,.tool-settings-word,.save-state{display:none}.iconbtn{width:42px;min-width:42px;padding:0}.panel{align-self:end;width:100%;max-height:94dvh;border-radius:22px 22px 0 0}.overlay{padding:0}.panelbody{padding:10px}.row{align-items:flex-start;flex-direction:column;gap:7px}.row>select,.accent-controls{width:100%}.switch{align-self:flex-end;margin-top:-36px}.actions>*{flex:1 1 130px}}@media(max-width:380px){.brandcopy strong{font-size:12px}.brandcopy small{font-size:9px}.toolicon{width:26px;height:26px}.toollabel{font-size:8.5px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}</style><style id="mlm-main-shell-compact-topnav-v9135">
/* v9.13.6 main-shell only: icon-only top navigation. Embedded tool payloads are protected. */
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important;border:0!important}
.shell{grid-template-rows:58px minmax(0,1fr)!important}
.appbar{display:grid!important;grid-template-columns:minmax(0,1fr) max-content!important;align-items:center!important;gap:8px!important;min-height:58px!important;padding:0 10px!important}
.brand,.brandmark,.brandcopy,.toolrail,.colorbtn{display:none!important}
.toptools{display:grid!important;grid-template-columns:repeat(5,minmax(0,1fr))!important;justify-content:stretch!important;align-items:center!important;gap:5px!important;min-width:0!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important}
.toptools .tool{position:relative!important;display:grid!important;place-items:center!important;width:46px!important;height:46px!important;min-width:46px!important;min-height:46px!important;padding:0!important;margin:0!important;border:1px solid transparent!important;border-radius:12px!important;background:transparent!important;color:var(--muted)!important;box-shadow:none!important;transform:none!important}
.toptools .tool:hover{transform:none!important;border-color:var(--line)!important;background:var(--surface2)!important;color:var(--text)!important}
.toptools .tool:active{transform:scale(.96)!important;box-shadow:none!important}
.toptools .tool.active,.toptools .tool[aria-current="page"]{border-color:color-mix(in srgb,var(--accent) 34%,var(--line))!important;background:var(--accentSoft)!important;color:var(--accent)!important;box-shadow:none!important}
.toptools .tool.active::after,.toptools .tool[aria-current="page"]::after{content:""!important;position:absolute!important;left:50%!important;right:auto!important;top:auto!important;bottom:3px!important;width:5px!important;height:5px!important;transform:translateX(-50%)!important;border:0!important;border-radius:50%!important;background:var(--accent)!important}
.toptools .toolicon,.toptools .tool.active .toolicon,.toptools .tool[aria-current="page"] .toolicon{display:grid!important;place-items:center!important;width:31px!important;height:31px!important;padding:0!important;border:0!important;border-radius:0!important;background:transparent!important;color:inherit!important;box-shadow:none!important}
.toptools .toolicon svg{width:24px!important;height:24px!important}
.toollabel{display:none!important}
.appmeta{display:flex!important;align-items:center!important;gap:0!important;margin:0!important}
.settings-gear{display:grid!important;place-items:center!important;width:44px!important;height:44px!important;min-width:44px!important;padding:0!important;border:1px solid transparent!important;border-radius:12px!important;background:transparent!important;color:var(--text)!important;cursor:pointer!important;transition:background-color var(--normal) var(--ease),border-color var(--normal) var(--ease),transform var(--fast) var(--ease)!important}
.settings-gear:hover{background:var(--surface2)!important;border-color:var(--line)!important}
.settings-gear:active{transform:scale(.96)!important}
.settings-gear svg{width:23px!important;height:23px!important;fill:none!important;stroke:currentColor!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important}
.current-tool-settings .action{width:100%}
.workspace{grid-row:2!important}
.shell.editor-focus{grid-template-rows:1fr!important}.shell.editor-focus .appbar{display:none!important}.shell.editor-focus .workspace{grid-row:1!important}
@media(max-width:720px){
 .shell{grid-template-rows:56px minmax(0,1fr)!important}
 .appbar{min-height:56px!important;grid-template-columns:minmax(0,1fr) 42px!important;gap:4px!important;padding:0 6px!important}
 .toptools{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:4px!important}
 .toptools .tool{width:42px!important;height:42px!important;min-width:42px!important;min-height:42px!important;border-radius:11px!important}
 .toptools .toolicon,.toptools .tool.active .toolicon,.toptools .tool[aria-current="page"] .toolicon{width:29px!important;height:29px!important}
 .toptools .toolicon svg{width:22px!important;height:22px!important}
 .settings-gear{width:42px!important;height:42px!important;min-width:42px!important;border-radius:11px!important}
 .settings-gear svg{width:22px!important;height:22px!important}
}
@media(max-width:360px){
 .appbar{gap:3px!important;padding:0 4px!important}
 .toptools{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:2px!important}
 .toptools .tool{width:40px!important;height:40px!important;min-width:40px!important;min-height:40px!important;border-radius:10px!important}
 .toptools .toolicon svg{width:21px!important;height:21px!important}
 .settings-gear{width:40px!important;height:40px!important;min-width:40px!important}
}
@media(max-width:330px){
 .toptools{grid-template-columns:repeat(5,38px)!important;gap:2px!important}
 .toptools .tool{width:38px!important;height:38px!important;min-width:38px!important;min-height:38px!important}
 .toptools .toolicon svg{width:20px!important;height:20px!important}
 .settings-gear{width:38px!important;height:38px!important;min-width:38px!important}
}
</style></head><body>
<a class="skip" href="#workspace">Skip to current tool</a><div class="shell" id="shell"><header class="appbar"><span class="sr-only" id="activeTitle" aria-live="polite">Focus</span><nav class="toptools" id="toolList" aria-label="Switch My Life Manager tool"></nav><div class="appmeta"><span class="save-state sr-only" id="globalSaveState" data-state="saved" role="status" aria-live="polite"><span class="save-copy">Saved locally</span></span><input id="navAccentPicker" type="color" value="#2f766d" aria-label="Choose global accent color" hidden><button class="settings-gear" id="settingsBtn" type="button" aria-label="Open My Life Manager settings" aria-expanded="false" title="Settings"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.12 2.12-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V20.3h-3v-.08a1.7 1.7 0 0 0-1.03-1.56 1.7 1.7 0 0 0-1.88.34l-.06.06-2.12-2.12.06-.06A1.7 1.7 0 0 0 7 15a1.7 1.7 0 0 0-1.56-1.03H5.3v-3h.14A1.7 1.7 0 0 0 7 9.94a1.7 1.7 0 0 0-.34-1.88L6.6 8l2.12-2.12.06.06a1.7 1.7 0 0 0 1.88.34A1.7 1.7 0 0 0 11.7 4.7v-.1h3v.1a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06L19.8 8l-.06.06a1.7 1.7 0 0 0-.34 1.88 1.7 1.7 0 0 0 1.56 1.03h.14v3h-.14A1.7 1.7 0 0 0 19.4 15z"/></svg></button></div></header><main class="workspace" id="workspace" aria-live="polite"><div class="loading" id="loading"><div class="loadingcard"><span class="spinner" aria-hidden="true"></span><strong id="loadingTitle">Opening Focus Ledger</strong><span>Only the tool you need is loaded.</span></div></div></main></div>
<div class="overlay" id="settingsOverlay" hidden><section class="panel" role="dialog" aria-modal="true" aria-labelledby="settingsTitle"><header class="panelhead"><div><h2 id="settingsTitle">My Life Manager settings</h2><p>Global controls shared by all five tools</p></div><button class="iconbtn" id="settingsClose" type="button" aria-label="Close settings">×</button></header><div class="panelbody">
<section class="card current-tool-settings"><h3>Current tool</h3><p>Open settings for the page you are currently using.</p><button class="action" id="toolSettingsBtn" type="button">Open current tool settings</button></section>
<section class="card"><h3>Appearance</h3><p>One Focus Ledger-style design and one accent color are used everywhere.</p><div class="row"><div class="copy"><b>Accent color</b><small>Buttons, selected tabs, highlights and focus rings in every tool</small></div><div class="accent-controls"><input id="accentPicker" type="color" value="#2f766d" aria-label="Choose global accent color"><select id="accentPreset" aria-label="Accent preset"><option value="#2f766d">Focus green</option><option value="#2563a6">Ocean blue</option><option value="#7450a7">Royal purple</option><option value="#b45f16">Warm orange</option><option value="#b23a48">Rose</option><option value="#4b5563">Slate</option><option value="custom">Custom</option></select><button class="action" id="resetAccent" type="button">Reset</button></div></div><div class="row"><div class="copy"><b>Appearance</b><small>Follow device, soft neutral or dark</small></div><select id="themeSelect"><option value="system">Follow device</option><option value="soft">Soft neutral</option><option value="dark">Dark</option></select></div><div class="row"><div class="copy"><b>Text size</b><small>Reading size across every tool</small></div><selec
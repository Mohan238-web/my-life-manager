<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>My Life Manager</title>
<style>:root{--bg:#0b1220;--line:#23314b;--text:#eef4ff;--muted:#9cabbe}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#fff;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}#frame{display:block;width:100%;height:100%;border:0;background:#fff}#edge{position:fixed;z-index:30;left:0;top:50%;width:30px;height:64px;transform:translateY(-50%);border:1px solid var(--line);border-left:0;border-radius:0 14px 14px 0;background:var(--bg);color:var(--text);font-size:20px;cursor:pointer;box-shadow:0 8px 28px #0008}#nav{position:fixed;z-index:40;inset:0 auto 0 0;width:min(290px,86vw);padding:calc(20px + env(safe-area-inset-top)) 14px 20px;transform:translateX(-105%);transition:transform .2s ease;background:linear-gradient(180deg,#0c1424,#08101d);border-right:1px solid var(--line);box-shadow:16px 0 42px #0009;color:var(--text)}body.open #nav{transform:translateX(0)}body.open #edge{opacity:0;pointer-events:none}.head{display:flex;align-items:center;justify-content:space-between;margin:0 4px 20px}.title{font-size:18px;font-weight:800}.close{width:36px;height:36px;border:1px solid var(--line);border-radius:11px;background:#111c30;color:var(--text);font-size:20px;cursor:pointer}.items{display:grid;gap:9px}.item{display:flex;align-items:center;gap:12px;width:100%;padding:13px 14px;border:1px solid transparent;border-radius:13px;background:transparent;color:var(--text);font:600 15px/1.2 inherit;text-align:left;cursor:pointer}.item:hover{background:#111c30;border-color:var(--line)}.item.active{background:#172946;border-color:#315486}.num{display:grid;place-items:center;flex:0 0 28px;height:28px;border-radius:9px;background:#20324d;color:#bcd5ff}.hint{position:absolute;left:18px;right:18px;bottom:20px;color:var(--muted);font-size:12px;line-height:1.5}#shade{position:fixed;z-index:35;inset:0;background:#0007;opacity:0;pointer-events:none;transition:opacity .2s}body.open #shade{opacity:1;pointer-events:auto}#loading{position:fixed;z-index:20;inset:0;display:grid;place-items:center;background:#07101d;color:#dce9ff;font:600 14px system-ui}#loading.hide{display:none}@media(prefers-reduced-motion:reduce){#nav,#shade{transition:none}}</style></head>
<body><div id="loading">Opening Focus Ledger…</div><iframe id="frame" title="Focus Ledger" sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-downloads allow-popups allow-popups-to-escape-sandbox"></iframe><button id="edge" type="button" aria-label="Open navigation">›</button><div id="shade"></div><nav id="nav" aria-label="Workspace websites"><div class="head"><div class="title">My Life Manager</div><button class="close" type="button" aria-label="Close navigation">×</button></div><div class="items"></div><div class="hint">Tap the left-edge arrow to change website.</div></nav>
<script>const pages=[{"id":"focus","name":"Focus Ledger","icon":"◎","data":"
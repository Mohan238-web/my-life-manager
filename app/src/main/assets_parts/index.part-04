YUA0NVi0fHXj07PszmabjOp8+ODyGUb3p8uMxX0fTZ/w9LMkWrIg0BAA=="}];const frame=document.querySelector('#frame'),items=document.querySelector('.items'),edge=document.querySelector('#edge'),loading=document.querySelector('#loading');let active=-1,hideTimer;const setOpen=v=>{document.body.classList.toggle('open',v);clearTimeout(hideTimer);if(v)hideTimer=setTimeout(()=>setOpen(false),1800)};async function unpack(data){const bytes=Uint8Array.from(atob(data),c=>c.charCodeAt(0));const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return await new Response(stream).text()}async function openPage(index){if(index===active){setOpen(false);return}active=index;const page=pages[index];loading.textContent='Opening '+page.name+'…';loading.classList.remove('hide');frame.title=page.name;frame.srcdoc=await unpack(page.data);[...items.children].forEach((b,i)=>b.classList.toggle('active',i===index));setOpen(false)}pages.forEach((p,i)=>{const b=document.createElement('button');b.className='item';b.type='button';b.innerHTML='<span class="num">'+p.icon+'</span><span>'+p.name+'</span>';b.onclick=()=>openPage(i);items.append(b)});frame.addEventListener('load',()=>loading.classList.add('hide'));edge.onclick=()=>setOpen(true);document.querySelector('.close').onclick=()=>setOpen(false);document.querySelector('#shade').onclick=()=>setOpen(false);document.addEventListener('keydown',e=>{if(e.key==='Escape')setOpen(false)});openPage(0);</script></body></html>